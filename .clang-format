# Tested with clang-format 21.1.8. See devtools/format/README.md before use.
# Stock clang-format cannot express our no-space-before-brace / }else{ style.
# This is a review proposal, not authorization to change that convention.
BasedOnStyle: LLVM
Language: Cpp
Standard: Latest
IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 0
LineEnding: DeriveCRLF
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: Never
FixNamespaceComments: false
NamespaceIndentation: None
CompactNamespaces: false
AccessModifierOffset: -4
IndentCaseLabels: false
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
SpaceBeforeCpp11BracedList: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty
InsertBraces: false
RemoveBracesLLVM: false
BreakConstructorInitializers: BeforeComma
BinPackArguments: false
BinPackParameters: OnePerLine
