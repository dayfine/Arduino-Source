load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "frlg_overworld",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_Tests.cpp",
            "*Reader.cpp",
            "PokemonFRLG_OverworldBike.cpp",
            "PokemonFRLG_OverworldFacing.cpp",
            "PokemonFRLG_OverworldWalk.cpp",
        ],
    ),
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
        "**/*.tpp",
    ]),
    deps = [
        "//Common/Cpp:common_cpp",
        "//SerialPrograms/Source/Pokemon:pokemon_navigation",
        "//SerialPrograms/Source/Pokemon:pokemon_types",
        "//SerialPrograms/Source/Pokemon/AutoStory:pokemon_autostory",
        "//:serial_programs_headers",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "frlg_overworld_readers",
    srcs = glob(["*Reader.cpp"]) + [
        "PokemonFRLG_OverworldBike.cpp",
        "PokemonFRLG_OverworldFacing.cpp",
        "PokemonFRLG_OverworldWalk.cpp",
    ],
    hdrs = glob([
        "**/*.h",
        "**/*.hpp",
        "**/*.tpp",
    ]),
    deps = [
        ":frlg_overworld",
        "//Common/Cpp:common_cpp",
        "//SerialPrograms/Source:frlg_inference_deps",
        "//:serial_programs_headers",
    ],
    visibility = ["//visibility:public"],
)
