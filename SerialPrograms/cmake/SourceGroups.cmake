# Keep authored files in their existing IDE tree and generated files in a group
# independent of the build directory's location (e.g. external Qt qrc output).
function(pa_source_groups ROOT)
    set(AUTHORED)
    set(GENERATED)
    foreach(SOURCE IN LISTS ARGN)
        get_source_file_property(IS_GENERATED "${SOURCE}" GENERATED)
        if(IS_GENERATED)
            list(APPEND GENERATED "${SOURCE}")
        else()
            list(APPEND AUTHORED "${SOURCE}")
        endif()
    endforeach()
    if(AUTHORED)
        source_group(TREE "${ROOT}" FILES ${AUTHORED})
    endif()
    if(GENERATED)
        source_group("Generated Files" FILES ${GENERATED})
    endif()
endfunction()
