# Writes BuildCommit.cpp, the definition of PROGRAM_COMMIT
# (Source/CommonFramework/BuildCommit.h): the git commit the app is built from.
#
# Run as a script on every build:
#   cmake -DSOURCE_DIR=<a folder in the repository> -DOUTPUT=<.../BuildCommit.cpp> -P BuildCommit.cmake
# The file is rewritten only when its text changes, so an unchanged commit
# rebuilds nothing. Without git, or outside a repository, the commit is "unknown".

set(PA_COMMIT "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    #  --match with a pattern no tag has: always the hash, never a tag name.
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --always --dirty --abbrev=12 --match "no-tag-matches-this"
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE PA_DESCRIBE
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE PA_RESULT
        ERROR_QUIET
    )
    if(PA_RESULT EQUAL 0 AND NOT PA_DESCRIBE STREQUAL "")
        set(PA_COMMIT "${PA_DESCRIBE}")
    endif()
endif()

set(PA_TEXT "//  Generated by cmake/BuildCommit.cmake. Do not edit.\n\nnamespace PokemonAutomation{\n    extern const char* const PROGRAM_COMMIT;\n    const char* const PROGRAM_COMMIT = \"${PA_COMMIT}\";\n}\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" PA_OLD_TEXT)
else()
    set(PA_OLD_TEXT "")
endif()
if(NOT PA_OLD_TEXT STREQUAL PA_TEXT)
    file(WRITE "${OUTPUT}" "${PA_TEXT}")
endif()
