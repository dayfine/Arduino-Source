# pa_embed_text_files(): builds the text of data files into the program.
#
#     pa_embed_text_files(<target> <folder> <header> <namespace> <function>)
#
# Reads every <folder>/*.json (relative to the calling CMakeLists.txt) and
# writes a C++ file to the build folder, compiled into <target>, that defines
# in <namespace>
#
#     const std::vector<std::pair<std::string, std::string>>& <function>();
#
# returning (file name without ".json", file text) for each file, sorted by
# name. <header>, an include path, declares that function. The files stay
# plain files in the repo; nothing generated is committed. Adding, removing or
# changing a file reruns CMake at the next build.
#
# Each text is split into raw string literals of at most 16000 bytes, joined
# at run time, so no literal exceeds MSVC's limit of 16380 bytes.

function(pa_embed_text_files TARGET FOLDER HEADER NAMESPACE FUNCTION)
    file(GLOB FILES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${FOLDER}/*.json")
    if(NOT FILES)
        message(FATAL_ERROR "pa_embed_text_files(): no .json files in ${FOLDER}.")
    endif()
    list(SORT FILES)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${FILES})

    set(ENTRIES "")
    foreach(FILE IN LISTS FILES)
        get_filename_component(NAME "${FILE}" NAME_WLE)
        file(READ "${FILE}" TEXT)
        string(FIND "${TEXT}" ")json\"" CLOSE)
        string(LENGTH "${TEXT}" LENGTH)
        if(NOT CLOSE EQUAL -1 OR LENGTH EQUAL 0)
            message(FATAL_ERROR "pa_embed_text_files(): ${FILE} is empty or contains )json\".")
        endif()
        set(PARTS "")
        set(START 0)
        while(START LESS LENGTH)
            string(SUBSTRING "${TEXT}" ${START} 16000 PART)
            string(APPEND PARTS "\n            R\"json(${PART})json\",")
            math(EXPR START "${START} + 16000")
        endwhile()
        string(APPEND ENTRIES "        {\"${NAME}\", join({${PARTS}\n        })},\n")
    endforeach()

    set(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/EmbeddedText/${FUNCTION}.cpp")
    file(WRITE "${OUTPUT}.new"
"//  Generated by SerialPrograms/cmake/EmbedTextFiles.cmake from
//  ${FOLDER}/*.json. Do not edit.

#include <initializer_list>
#include <string>
#include <utility>
#include <vector>
#include \"${HEADER}\"

namespace ${NAMESPACE}{


namespace{

std::string join(std::initializer_list<const char*> parts){
    std::string text;
    for (const char* part : parts){
        text += part;
    }
    return text;
}

}


const std::vector<std::pair<std::string, std::string>>& ${FUNCTION}(){
    static const std::vector<std::pair<std::string, std::string>> FILES{
${ENTRIES}    };
    return FILES;
}


}
")
    #   Copied only if it changed, so an unchanged file isn't recompiled.
    configure_file("${OUTPUT}.new" "${OUTPUT}" COPYONLY)
    target_sources(${TARGET} PRIVATE "${OUTPUT}")
endfunction()
