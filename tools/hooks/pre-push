#!/bin/sh
# Pre-push code-health gate: the same check as CI's "C++ Code Health" job, run locally (about 1 s).
# Installed by tools/install_hooks.sh as a stub that runs the latest copy from origin/agents.
#
# For each pushed branch whose commit is this worktree's HEAD, run the code-health linter against a base
# and refuse the push on any failure. The base is, in order: the branch's fork PR base; the branch's
# recorded base (git config branch.<name>.pr-base <base branch>; set it before a stacked branch's
# first push, when it has no PR yet); for a branch already on the remote (lab/main and other branches
# without a PR), the remote's current tip, so only what this push adds is checked; else origin/main. Pushes of other commits
# (e.g. pa-sync's merges made without a checkout), deletions and tags are not checked, nor are pushes
# from a tree without SerialPrograms/ (the agents branch).
# The linter is devtools/code_health on origin/agents, like this hook; PA_AGENTS_DIR=<agents checkout>
# runs a local copy instead (to try linter changes). Bypass (git push --no-verify) only with the user's
# OK for that push.
remote=$1
case "$(git remote get-url "$remote" 2>/dev/null)" in *dayfine/Arduino-Source*) ;; *) exit 0;; esac
[ -d SerialPrograms ] || exit 0
PY=${CODE_HEALTH_PY:-$HOME/.venvs/code-health/bin/python}
code=$(pwd)
head=$(git rev-parse HEAD)
tools=
tmp=
trap '[ -z "$tmp" ] || rm -rf "$tmp"' EXIT
status=0
while read -r lref lsha rref rsha; do
    case "$rref" in refs/heads/*) ;; *) continue;; esac
    [ "$lsha" = 0000000000000000000000000000000000000000 ] && continue
    [ "$lsha" = "$head" ] || { echo "pre-push: ${rref#refs/heads/} is not HEAD here, code health not checked" >&2; continue; }
    if [ ! -x "$PY" ]; then
        echo "pre-push: no code-health venv at $PY; run: sh <(git show origin/agents:tools/install_hooks.sh)" >&2
        exit 1
    fi
    if [ -z "$tools" ]; then
        if [ -n "$PA_AGENTS_DIR" ]; then
            tools=$PA_AGENTS_DIR
        elif tmp=$(mktemp -d "${TMPDIR:-/tmp}/pa-code-health.XXXXXX") \
            && git archive origin/agents devtools/code_health 2>/dev/null | tar -x -C "$tmp" 2>/dev/null \
            && [ -d "$tmp/devtools/code_health" ]; then
            tools=$tmp
        elif [ -d devtools/code_health ]; then
            tools=$code  # older code branches still carry their own copy
        else
            echo "pre-push: no devtools/code_health on origin/agents; run git fetch origin agents" >&2
            exit 1
        fi
        [ -d "$tools/devtools/code_health" ] || { echo "pre-push: no devtools/code_health in $tools" >&2; exit 1; }
    fi
    br=${rref#refs/heads/}
    base=$(gh pr view "$br" -R dayfine/Arduino-Source --json baseRefName -q .baseRefName 2>/dev/null)
    [ -n "$base" ] || base=$(git config "branch.$br.pr-base")
    if [ -n "$base" ] && git rev-parse -q --verify "origin/$base" >/dev/null; then
        baseref=origin/$base
    elif [ "$rsha" != 0000000000000000000000000000000000000000 ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        baseref=$rsha
        base="$br's remote tip ${rsha%"${rsha#????????????}"}"
    else
        base=main
        baseref=origin/main
    fi
    out=$(cd "$tools" && "$PY" -m devtools.code_health --root "$code" --base-ref "$baseref" 2>&1)
    rc=$?
    n=$(printf '%s\n' "$out" | sed -n 's/^Code health: \([0-9]*\) failure.*/\1/p')
    if [ $rc != 0 ] || { [ -n "$n" ] && [ "$n" != 0 ]; }; then
        printf '%s\n' "$out" | grep -v '^Advisory' | tail -25 >&2
        echo "pre-push: $br fails code health (${n:-?} failures vs $base); push refused. Fix in this PR's commits, or set git config branch.$br.pr-base if the base is wrong." >&2
        status=1
    fi
done
exit $status
